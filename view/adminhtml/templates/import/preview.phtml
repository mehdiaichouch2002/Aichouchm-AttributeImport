 * @var \Aichouchm\AttributeImport\Block\Adminhtml\Import\Preview $block
 * @var \Magento\Framework\Escaper $escaper
 */
$rows   = (array) $block->getData('rows');
$errors = (array) $block->getData('errors');
?>
<?php if ($errors !== []): ?>
    <div class="messages">
        <?php foreach ($errors as $error): ?>
            <div class="message message-error"><?= $escaper->escapeHtml($error) ?></div>
        <?php endforeach; ?>
    </div>
<?php endif; ?>

<?php if (count($rows) > 1): ?>
    <div class="admin__data-grid-outer-wrap">
        <table class="data-grid admin__table-primary">
            <thead>
                <tr>
                    <?php foreach ($rows[0] as $header): ?>
                        <th class="data-grid-th"><?= $escaper->escapeHtml($block->formatHeader($header)) ?></th>
                    <?php endforeach; ?>
                </tr>
            </thead>
            <tbody>
                <?php foreach (array_slice($rows, 1) as $row): ?>
                    <tr>
                        <?php foreach ($row as $cell): ?>
                            <td><?= $escaper->escapeHtml($cell) ?></td>
                        <?php endforeach; ?>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    </div>
    <p class="note">
        <?= $escaper->escapeHtml(__('%1 data rows found.', count($rows) - 1)) ?>
        <?php if ($errors === []): ?>
            <strong><?= $escaper->escapeHtml(__('All rows are valid. You can proceed with the import.')) ?></strong>
        <?php endif; ?>
    </p>
<?php endif; ?>
