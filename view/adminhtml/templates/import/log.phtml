 * @var \Aichouchm\AttributeImport\Block\Adminhtml\Log $block
 * @var \Magento\Framework\Escaper $escaper
 */
$lines = $block->getLogLines();
?>
<div class="attribute-import-log">
    <div class="attribute-import-log-actions">
        <a href="<?= $escaper->escapeUrl($block->getImportUrl()) ?>" class="action-default">
            &larr; <?= $escaper->escapeHtml(__('Back to Import')) ?>
        </a>
    </div>

    <?php if ($lines === []): ?>
        <p class="message message-notice">
            <?= $escaper->escapeHtml(__('No log entries found. The log file is either empty or does not exist yet.')) ?>
        </p>
    <?php else: ?>
        <p class="note"><?= $escaper->escapeHtml(__('Showing last %1 log entries, newest first.', count($lines))) ?></p>
        <div class="attribute-import-log-lines">
            <?php foreach ($lines as $line): ?>
                <div class="<?= $escaper->escapeHtmlAttr($block->getLineClass($line)) ?>">
                    <?= $escaper->escapeHtml($line) ?>
                </div>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</div>
